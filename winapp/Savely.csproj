<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Savely</AssemblyName>
    <RootNamespace>Savely.App</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <Description>Савелий — кот-репетитор английского (приложение)</Description>
  </PropertyGroup>

  <!-- WebView2 — встроенный в Windows 10/11 движок Edge: приложение
       остаётся тонкой оболочкой, а весь сайт внутри работает как PWA
       (service worker и офлайн-кэш действуют и здесь). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
