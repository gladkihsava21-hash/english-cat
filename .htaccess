# Конфигурация для обычного хостинга с Apache + mod_wsgi (Timeweb и др.).
# На VPS не используется — там nginx, см. deploy/install.sh

# --- Что наружу не отдаём ни при каких условиях ---
# База лежит выше публичной папки, но правило оставляем на случай,
# если её кто-то скопирует внутрь: там хеши паролей и токены репетитора.
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Внутренние документы и скрипты наружу не отдаём. SESSION.md и AGENTS.md
# отдавались по прямой ссылке с кодом 200 — это подробная карта проекта
# (архитектура, прошлые дыры, имена колонок с хешами паролей). Денилист
# по расширению закрывает и их, и .sh/.conf/.bak, и подобное. .py сюда
# не берём: wsgi.py обязан обслуживаться; лишние .py гасит RewriteRule.
<FilesMatch "\.(md|markdown|sh|conf|cfg|ini|bak|jsonl|toml|yml|yaml|sample|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
# Резервные копии словаря (js/words.js.bak-*): матчим .bak в любом месте
# имени, не только на конце.
<FilesMatch "\.bak">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

# Админку не должно быть в поиске
<Files "admin.html">
    Header always set X-Robots-Tag "noindex, nofollow"
</Files>
DirectoryIndex index.html

# --- Точка входа в приложение ---
# Обработчик вешаем ТОЛЬКО на wsgi.py. Без этой директивы Apache не отдаёт
# запрос в Python и отвечает 403 — именно на этом всё и стояло.
# Вешать на все .py нельзя: у server.py и db.py нет callable application.
<Files "wsgi.py">
    SetHandler wsgi-script
    Options +ExecCGI
</Files>

# Шрифты лежат у нас (css/fonts/), и Apache по умолчанию отдаёт их с
# устаревшим application/font-woff2. Работать работает, но правильный
# тип с 2017 года — font/woff2, и по нему браузеры и прокси понимают,
# что файл уже сжат и упаковывать его второй раз незачем.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Исходники Python по прямой ссылке не отдаём: без обработчика
    # Apache показал бы их простым текстом.
    # Внутреннюю переадресацию ниже это не задевает — там путь длиннее
    # (/wsgi.py/api/...), а здесь шаблон закрыт на конце.
    RewriteRule ^(server|db|wsgi|mailer)\.py$ - [R=404,L]

    # В Python уходит только API. Всё остальное — статика, её Apache
    # отдаёт сам: быстрее, и сайт продолжает открываться, даже если
    # с приложением что-то не так.
    RewriteRule ^(api/.*|health)$ /wsgi.py/$1 [QSA,PT,L]
</IfModule>

# --- Про HTTPS ---
# Принудительного редиректа здесь НЕТ намеренно. Пока сертификат не выпущен,
# он сделал бы сайт недоступным: браузер уходил бы на https, которого ещё нет.
# Включать после выпуска SSL — переключателем в панели хостинга
# («Домены и SSL» → перенаправление на HTTPS).
#
# HTTPS обязателен для работы: без него браузер не даёт доступ к микрофону
# (голосовой чат) и не предлагает установку сайта на телефон.

# Кэширование: страницы — НИКОГДА, всё остальное — надолго.
# =========================================================================
# Заголовков кэша тут не было вовсе, и браузер решал сам: по Last-Modified
# он придерживает html на своё усмотрение. А весь механизм обновления сайта
# держится на том, что страница свежая: номер версии (?v=НОМЕР) прописан
# ВНУТРИ html, и пока браузер отдаёт старую страницу из своего кэша, он
# тянет и старые css/js по старым адресам. То есть выкладка не доезжала до
# человека, пока он не обновит страницу руками.
#
# Файлы со всеми ?v= наоборот кэшируем надолго: их адрес меняется вместе с
# версией, поэтому устареть они не могут.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|json)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2|png|jpg|svg)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Заголовки безопасности. Ставим и здесь (статику Apache отдаёт сам,
    # минуя Python), и в ответах приложения (server.py/wsgi.py) — заодно
    # проверяем curl'ом, что nginx впереди их не срезает. Тут только
    # безопасные под прокси: nosniff, запрет на встраивание в чужой iframe
    # (кликджекинг админки/панели), скрытие Referer.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"

    # HSTS. Редирект http→https уже включён в панели хостинга; этот заголовок
    # закрывает оставшуюся щель — первый заход по http до редиректа, где и
    # ловят SSL-strip. Браузер, получив HSTS по https, дальше сам ходит
    # только по https. Срок пока 30 дней (не год): сертификат на Timeweb
    # продлевается автоматически и не нами; если однажды не продлится, длинный
    # HSTS запер бы людей. Поднять после первого пережитого автопродления.
    # preload не ставим намеренно — отдельный необратимый шаг.
    # CSP по-прежнему отдельно: сырой ломает инлайн-стили и скрипты.
    Header always set Strict-Transport-Security "max-age=2592000; includeSubDomains"
</IfModule>
