# Конфигурация для обычного хостинга с Apache + mod_wsgi (Timeweb и др.).
# На VPS не используется — там nginx, см. deploy/install.sh

# --- Что наружу не отдаём ни при каких условиях ---
# База лежит выше публичной папки, но правило оставляем на случай,
# если её кто-то скопирует внутрь: там хеши паролей и токены репетитора.
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
DirectoryIndex index.html

# --- Точка входа в приложение ---
# Обработчик вешаем ТОЛЬКО на wsgi.py. Без этой директивы Apache не отдаёт
# запрос в Python и отвечает 403 — именно на этом всё и стояло.
# Вешать на все .py нельзя: у server.py и db.py нет callable application.
<Files "wsgi.py">
    SetHandler wsgi-script
    Options +ExecCGI
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Исходники Python по прямой ссылке не отдаём: без обработчика
    # Apache показал бы их простым текстом.
    # Внутреннюю переадресацию ниже это не задевает — там путь длиннее
    # (/wsgi.py/api/...), а здесь шаблон закрыт на конце.
    RewriteRule ^(server|db|wsgi)\.py$ - [R=404,L]

    # В Python уходит только API. Всё остальное — статика, её Apache
    # отдаёт сам: быстрее, и сайт продолжает открываться, даже если
    # с приложением что-то не так.
    RewriteRule ^(api/.*|health)$ /wsgi.py/$1 [QSA,PT,L]
</IfModule>

# --- Про HTTPS ---
# Принудительного редиректа здесь НЕТ намеренно. Пока сертификат не выпущен,
# он сделал бы сайт недоступным: браузер уходил бы на https, которого ещё нет.
# Включать после выпуска SSL — переключателем в панели хостинга
# («Домены и SSL» → перенаправление на HTTPS).
#
# HTTPS обязателен для работы: без него браузер не даёт доступ к микрофону
# (голосовой чат) и не предлагает установку сайта на телефон.
